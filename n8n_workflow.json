{
  "name": "Content Classifier → PDF",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "classify-posts",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-in",
      "name": "Webhook — получить посты",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8001/classify/pdf",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "posts": "={{ $json.body.posts || $json.posts }}",
          "channel": "={{ $json.body.channel || $json.channel || '' }}",
          "title": "={{ $json.body.title || $json.title || 'Дайджест' }}"
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "http-classifier",
      "name": "Классификатор → PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "operation": "sendDocument",
        "chatId": "={{ $('Webhook — получить посты').item.json.body.chat_id || $('Webhook — получить посты').item.json.chat_id }}",
        "binaryData": true,
        "binaryProperty": "data",
        "additionalFields": {
          "caption": "📊 Дайджест готов!\n🔴 Важно: {{ $('Классификатор → PDF').item.json.HIGH_count }}\n🟡 Средне: {{ $('Классификатор → PDF').item.json.MEDIUM_count }}\n🟢 Не важно: {{ $('Классификатор → PDF').item.json.LOW_count }}"
        }
      },
      "id": "telegram-send",
      "name": "Telegram — отправить PDF",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 300],
      "notes": "Вставьте свои Telegram credentials"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"message\": \"PDF отправлен\" }"
      },
      "id": "respond",
      "name": "Ответ вебхуку",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 300]
    }
  ],
  "connections": {
    "Webhook — получить посты": {
      "main": [[{ "node": "Классификатор → PDF", "type": "main", "index": 0 }]]
    },
    "Классификатор → PDF": {
      "main": [[{ "node": "Telegram — отправить PDF", "type": "main", "index": 0 }]]
    },
    "Telegram — отправить PDF": {
      "main": [[{ "node": "Ответ вебхуку", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
